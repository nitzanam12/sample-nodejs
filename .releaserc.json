{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", {
      "prepareCmd": "docker tag sample-nodejs:$GITHUB_SHA $ECR:v${nextRelease.version} && docker push $ECR:v${nextRelease.version}"
    }],
    ["@semantic-release/github", {
      "successComment": false,
      "failComment": false,
      "releasedLabels": false
    }]
  ]
}